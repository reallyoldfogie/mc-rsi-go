/docs/plans

# mc-agent's own runtime cache (downloaded protocol/block data, packet
# logs, agent logs) — created under the working directory by any live
# test (testing/*_live_test.go) that actually connects a bot session.
# Matches mc-agent's own .gitignore entry for the same directory.
.agent/
.agentStop

# itzg/minecraft-server container data bind-mounted into a live test's
# working directory by testing.EnsureServer (testing/mcserver.go) via
# mc-client-test-go's testenv.Manager — downloaded server jar, Mojang/Paper
# library jars, and server logs. Regenerated by any live test that
# actually launches a server (none of this is committed source).
/testing/libraries/
/testing/logs/
/testing/versions/
/cmd/*/libraries/
/cmd/*/logs/
/cmd/*/versions/
# Same reasoning, for pkg/pvp's and pkg/tournament's own live tests
# (pkg/pvp/run_live_test.go) - EnsureServer writes these relative to
# whatever package directory go test happens to run from.
/pkg/*/libraries/
/pkg/*/logs/
/pkg/*/versions/
/libraries/
/versions/
/logs/
/configs/runs/

# Real training run outputs (checkpoints, logs, mc-agent-config.json) -
# runtime artifacts, not source, and can be large (one JSON file per
# generation via pkg/lineage).
/runs/

/bin
*.log
.worktrees

/libraries
/rsi-train
/third_party
/versions

