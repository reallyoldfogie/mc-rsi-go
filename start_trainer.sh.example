#!/usr/bin/env bash
# Template for launching a supervised mc-rsi-trainer run.
#
# Copy this to start_trainer.sh (gitignored - every real run's own flag
# values are specific to that run/experiment, and may be worth keeping
# private even beyond that: a server address, a path that reveals more
# than you want committed, etc.) and fill in the placeholders below:
#
#   cp start_trainer.sh.example start_trainer.sh
#   cp run-flags.json.example runs/REPLACE-WITH-YOUR-RUN-NAME/run-flags.json
#   chmod +x start_trainer.sh
#   # edit run_dir below and runs/.../run-flags.json for your own run, then:
#   ./start_trainer.sh
#
# This uses -run-config (docs/plans/22-run-config-file.md) rather than
# spelling out every flag on the command line: run-flags.json.example is
# this template's companion, with the same flags documented the same
# way. See that file for the "which flags do I actually need" guidance -
# this script itself only needs to know where that file lives.
#
# Every flag's full meaning, default, and interaction with the others is
# still documented at its own definition in cmd/rsi-train/main.go's
# flag.*Var usage strings - run `./bin/rsi-train -h` to see all of them
# at once. See docs/getting-started.md for the overall setup this
# assumes (a running mc-agent-compatible Minecraft server with RCON
# enabled).
#
# This launches scripts/supervise-rsi-train.sh, which restarts rsi-train
# on its own if the run exits unexpectedly, detached from this shell via
# setsid/nohup so it survives the launching terminal closing. To stop a
# run started this way: `kill -TERM "$(cat run.pid)"` (saves a checkpoint
# first, rather than killing it outright). See docs/boot-time-autostart.md
# if you also want this wired into systemd for boot-time auto-start.

run_dir="runs/REPLACE-WITH-YOUR-RUN-NAME"

SUPERVISE_PIDFILE=run.pid setsid nohup scripts/supervise-rsi-train.sh "$run_dir/train.log" \
  ./bin/rsi-train -run-config "$run_dir/run-flags.json" &
